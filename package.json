{
  "name": "finance-portal---op-management",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "build:exe": "npm run build && npx esbuild server/index.js --bundle --platform=node --target=node20 --outfile=dist/server.js --external:mssql --external:msnodesqlv8 --external:sqlite3 --external:sqlite && npm exec -- pkg dist/server.js --targets node20-win-x64 --out-path build"
  },
  "bin": "server/index.js",
  "pkg": {
    "scripts": [],
    "assets": [
      "node_modules/puppeteer/**/*",
      "node_modules/puppeteer-core/**/*",
      "node_modules/mssql/**/*",
      "node_modules/tedious/**/*",
      "node_modules/msnodesqlv8/**/*",
      "node_modules/sqlite3/**/*",
      "node_modules/sqlite/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "msnodesqlv8": "^5.1.3",
    "mssql": "^12.2.0",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.1",
    "puppeteer": "^24.37.5",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.7.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.27.3",
    "pkg": "^5.8.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
